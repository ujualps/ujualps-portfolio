datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  role       String   @default("user")
  createdAt  DateTime @default(now())
  events     TheyyamEvent[]
}

model TheyyamEvent {
  id           Int        @id @default(autoincrement())
  templateName String
  mainDeity    String
  description  String?
  location     String?
  eventStart   DateTime
  eventEnd     DateTime
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    Int?
  creator      User?      @relation(fields: [createdBy], references: [id])
  media        EventMedia[]
}

model EventMedia {
  id         Int      @id @default(autoincrement())
  eventId    Int
  mediaUrl   String
  mediaType  String   @default("poster")
  uploadedAt DateTime @default(now())
  event      TheyyamEvent @relation(fields: [eventId], references: [id])
}